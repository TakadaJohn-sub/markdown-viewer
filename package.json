{
  "name": "markdown-viewer",
  "productName": "Markdown Viewer",
  "version": "1.0.1",
  "private": true,
  "description": "A lightweight desktop viewer for reading Markdown files",
  "main": "dist-electron/main.js",
  "author": "takadajohn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TakadaJohn-sub/markdown-viewer.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "package": "vite build && electron-builder --mac --dir",
    "dist": "vite build && electron-builder --mac"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.16.47",
    "mermaid": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
